generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Section {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  link         String?
  description  String
  wallpaperUrl String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agendas      Agenda[]
}

model Agenda {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String   @default("")
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([sectionId, slug])
  @@index([sectionId])
}

model PddUser {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}